# Binance USDT-M Futures (binanceusdm)
BINANCE_API_KEY=replace_me
BINANCE_API_SECRET=replace_me

# Safety: keep true until verified
DRY_RUN=true

# Trading
SYMBOL=BTC/USDT:USDT
TIMEFRAME=5m
LEVERAGE=3

# Funding strategy
# FundingRate is a decimal, e.g. 0.0003 = 0.03%
FUNDING_RATE_ENTRY=0.0005
FUNDING_RATE_EXIT=0.0002
ENTER_WINDOW_SECONDS=1800

# Risk
RISK_PER_TRADE=0.005
MAX_INITIAL_MARGIN_PCT=0.25
DAILY_MAX_LOSS_PCT=0.03

# Stops (ATR based)
ATR_PERIOD=14
ATR_STOP_MULT=2.0
TP_MULT=3.0
ENABLE_TRAIL=true
TRAIL_AFTER_R_MULT=1.0
TRAIL_STOP_R_MULT=0.5

# Loop
POLL_SECONDS=15
